{
  "name": "ossgrid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:data": "node --import tsx --test scripts/tests/*.test.ts",
    "sync:data": "node --import tsx scripts/fetch-lfx-data.ts",
    "audit:data": "node --import tsx scripts/audit-data.ts && node --import tsx scripts/audit-gsoc-data.ts && node --import tsx scripts/audit-programs.ts && node --import tsx scripts/audit-proposals.ts",
    "check:data": "node --import tsx scripts/fetch-lfx-data.ts --check",
    "check:copy": "node --import tsx scripts/check-copy.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "sync:gsoc": "node --import tsx scripts/fetch-gsoc-data.ts",
    "check:gsoc": "node --import tsx scripts/fetch-gsoc-data.ts --check",
    "audit:gsoc": "node --import tsx scripts/audit-gsoc-data.ts",
    "audit:programs": "node --import tsx scripts/audit-programs.ts",
    "sync:proposals": "node --import tsx scripts/fetch-proposals.ts",
    "check:proposals": "node --import tsx scripts/fetch-proposals.ts --check",
    "sync:contributors": "node --import tsx scripts/sync-contributors.ts"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "framer-motion": "^13.2.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
